{
    "name": "nawasara/alerting",
    "description": "Central incident bus for Nawasara — register alert rules, dispatch fire/resolve via Alerter facade, state-machine with cooldown + escalation, routes notifications to nawasara/notification channels.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nawasara",
        "laravel",
        "alerting",
        "incident",
        "monitoring",
        "observability"
    ],
    "authors": [
        {
            "name": "Pringgo J. Saputro",
            "email": "odyinggo@gmail.com",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/nawasara/alerting/issues",
        "source": "https://github.com/nawasara/alerting"
    },
    "autoload": {
        "psr-4": {
            "Nawasara\\Alerting\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^12.0",
        "spatie/laravel-permission": "^6.0",
        "nawasara/ui": "*",
        "nawasara/sync": "^0.2",
        "nawasara/notification": "^0.2",
        "nawasara/auth-primitives": "*",
        "livewire/livewire": "^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nawasara\\Alerting\\AlertingServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
